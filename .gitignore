# Generated content artifacts (rebuilt by `pnpm content:build`; never a source
# of truth — DESIGN-05). See docs/adr for the artifact ADR.
content/generated/

# Local git worktrees (AGENTS.md "dedicated worktree") — never tracked.
.worktrees/
apps/desktop/dist-electron/
# tsc -b emits alongside the sources it compiles
*.tsbuildinfo
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map



*.log
.DS_Store
.pnpm-store/
.claude/
.muse/

# Vendored Effect artifacts are committed verbatim (V1 vendor model) — the
# global `dist/` rule above must not swallow their published `dist/`.
# See scripts/vendor-effect-sync.mjs and vendor/effect/UPSTREAM.md.
!vendor/effect/dist/
!vendor/effect/dist/**
!vendor/effect-vitest/dist/
!vendor/effect-vitest/dist/**
apps/desktop/map-spike-assets/
apps/desktop/.map-data-cache/
