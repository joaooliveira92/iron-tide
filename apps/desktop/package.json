{
  "name": "@bluewave/desktop",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "com.bluewave.app",
  "scripts": {
    "dev": "node scripts/build-content.mjs && electron-vite dev",
    "dev:debug": "node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_DEBUG=true electron-vite dev",
    "dev:devtools": "node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_DEVTOOLS=true electron-vite dev",
    "build": "node scripts/build-content.mjs && electron-vite build && node scripts/check-renderer-bundle.mjs",
    "build:debug": "node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_DEBUG=true electron-vite build && cross-env VITE_BLUEWAVE_DEBUG=true node scripts/check-renderer-bundle.mjs",
    "map-data": "node scripts/map-data/cli.ts",
    "map-assets:verify": "node scripts/map-data/verify-production.mjs",
    "build:globe-spike": "node scripts/map-data/cli.ts fetch && node scripts/map-data/cli.ts bake && node scripts/map-data/cli.ts fixtures && node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_GLOBE_SPIKE=true electron-vite build && cross-env VITE_BLUEWAVE_GLOBE_SPIKE=true node scripts/check-renderer-bundle.mjs",
    "build:globe-adapter": "node scripts/build-content.mjs && electron-vite build && node scripts/check-renderer-bundle.mjs",
    "preview": "electron-vite preview",
    "pack": "pnpm build && electron-builder --config electron-builder.json",
    "pack:mac": "pnpm build && electron-builder --mac --config electron-builder.json",
    "pack:win": "pnpm build && electron-builder --win --config electron-builder.json",
    "pack:linux": "pnpm build && electron-builder --linux --config electron-builder.json",
    "clean": "rimraf --glob out dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --config playwright.debug.config.ts",
    "snap": "node scripts/view.ts",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "smoke:globe-adapter": "node scripts/globe-adapter-smoke.mjs",
    "smoke:globe-interactions": "node scripts/globe-packaged-interactions.mjs",
    "perf:globe": "node scripts/globe-audit-benchmark.mjs",
    "guard:package": "node scripts/package-guard/cli.ts",
    "lint": "vp lint .",
    "lint:fix": "echo 'ok'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bluewave/campaign": "workspace:*",
    "@bluewave/campaign-engine": "workspace:*",
    "@bluewave/combat": "workspace:*",
    "@bluewave/commands": "workspace:*",
    "@bluewave/content-compiler": "workspace:*",
    "@bluewave/content-schema": "workspace:*",
    "@bluewave/contracts": "workspace:*",
    "@bluewave/deterministic": "workspace:*",
    "@bluewave/diagnostics": "workspace:*",
    "@bluewave/events": "workspace:*",
    "@bluewave/messages": "workspace:*",
    "@bluewave/persistence": "workspace:*",
    "@bluewave/phase-engine": "workspace:*",
    "@bluewave/random": "workspace:*",
    "@bluewave/ship-design": "workspace:*",
    "@bluewave/ship-visual": "workspace:*",
    "@paper-design/shaders-react": "^0.0.81",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "workspace:*",
    "lucide-react": "^1.60.0",
    "maplibre-gl": "6.16.0",
    "motion": "^14.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@bluewave/test-support": "workspace:*",
    "@mapbox/vector-tile": "1.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.15",
    "@testing-library/react": "^16.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson-vt": "3.2.5",
    "@types/node": "^26.6.5",
    "@types/pbf": "3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shapefile": "0.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/vt-pbf": "3.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "cross-env": "^10.1.0",
    "d3-drag": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "electron": "44.9.2",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "4.0.0",
    "electron-vite": "^6.0.0",
    "geojson-vt": "5.0.4",
    "jsdom": "^30.1.3",
    "pbf": "3.3.0",
    "shapefile": "0.6.6",
    "tailwindcss": "^4.1.15",
    "topojson-client": "^3.1.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vt-pbf": "3.1.3"
  }
}
