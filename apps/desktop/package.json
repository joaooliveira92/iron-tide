{
  "name": "@bluewave/desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "com.bluewave.app",
  "scripts": {
    "dev": "node scripts/build-content.mjs && electron-vite dev",
    "dev:debug": "node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_DEBUG=true electron-vite dev",
    "dev:devtools": "node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_DEVTOOLS=true electron-vite dev",
    "build": "node scripts/build-content.mjs && electron-vite build && node scripts/check-renderer-bundle.mjs",
    "build:debug": "node scripts/build-content.mjs && cross-env VITE_BLUEWAVE_DEBUG=true electron-vite build && node scripts/check-renderer-bundle.mjs",
    "preview": "electron-vite preview",
    "pack": "pnpm build && electron-builder --config",
    "pack:mac": "pnpm build && electron-builder --mac --config",
    "pack:win": "pnpm build && electron-builder --win --config",
    "pack:linux": "pnpm build && electron-builder --linux --config",
    "clean": "rimraf --glob out dist *.tsbuildinfo",
    "typecheck": "tsc -b",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --config playwright.debug.config.ts",
    "snap": "node scripts/view.ts",
    "smoke:packaged": "node scripts/packaged-smoke.mjs",
    "lint": "vp lint .",
    "lint:fix": "echo 'ok'"
  },
  "dependencies": {
    "@bluewave/contracts": "workspace:*",
    "@bluewave/diagnostics": "workspace:*",
    "@bluewave/deterministic": "workspace:*",
    "@bluewave/content-schema": "workspace:*",
    "@bluewave/content-compiler": "workspace:*",
    "@bluewave/campaign": "workspace:*",
    "@bluewave/campaign-engine": "workspace:*",
    "@bluewave/combat": "workspace:*",
    "@bluewave/commands": "workspace:*",
    "@bluewave/events": "workspace:*",
    "@bluewave/persistence": "workspace:*",
    "@bluewave/phase-engine": "workspace:*",
    "@bluewave/random": "workspace:*",
    "effect": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@base-ui/react": "^1.9.0",
    "@paper-design/shaders-react": "^0.0.81",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "@bluewave/ship-design": "workspace:*",
    "@bluewave/ship-visual": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "@bluewave/test-support": "workspace:*",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "4.0.0",
    "electron-vite": "^5.0.0",
    "vite": "catalog:",
    "typescript": "7.0.2",
    "@types/node": "^26.6.5",
    "vite-plus": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.15",
    "@tailwindcss/vite": "^4.1.15",
    "jsdom": "^30.1.2",
    "@testing-library/react": "^16.3.3",
    "d3-drag": "^3.0.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/topojson-client": "^3.1.5",
    "@playwright/test": "^1.64.0",
    "cross-env": "^10.1.0"
  }
}
