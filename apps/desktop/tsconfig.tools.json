{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/tools",
    "rootDir": ".",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "scripts/view.ts",
    "scripts/snap-*.ts",
    "scripts/map-data/**/*.ts",
    "scripts/package-guard/**/*.ts",
    "src/renderer/components/globe-spike/densify.ts",
    "src/renderer/components/globe-spike/tilepack.ts",
    "src/renderer/components/world-map/map-geometry.ts",
    "e2e/flows.ts",
    "e2e/fixtures.ts",
    "e2e/preferences-fixture.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
