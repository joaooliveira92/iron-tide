{
  "name": "@bluewave/campaign",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./compiler": {
      "types": "./src/compiler-public.ts",
      "default": "./dist/compiler-public.js"
    },
    "./decline-records": {
      "types": "./src/declineRecords.ts",
      "default": "./dist/declineRecords.js"
    }
  },
  "dependencies": {
    "@bluewave/contracts": "workspace:*",
    "@bluewave/diagnostics": "workspace:*",
    "@bluewave/deterministic": "workspace:*",
    "@bluewave/armament": "workspace:*",
    "@bluewave/content-schema": "workspace:*",
    "@bluewave/content-compiler": "workspace:*",
    "yaml": "^2.9.1",
    "@bluewave/ship-design": "workspace:*",
    "effect": "workspace:*"
  },
  "devDependencies": {
    "@bluewave/test-support": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rimraf --glob dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "echo 'ok'"
  }
}
