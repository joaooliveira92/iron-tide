{
  "catMaxLines": 200,
  "readRangeMaxLines": 120,
  "readChainDenyAt": 3,
  "overrideToken": "agent-guard: allow",
  "overrideMinReasonChars": 3,
  "dispatchStampMaxMinutes": 240,
  "dispatchOverrideToken": "dispatch-check: skip",
  "minFreeGiB": 5,
  "contextOverrideToken": "ctx-override:",
  "contextAdvisorTokens": 100000,
  "contextWarnTokens": 150000,
  "contextBlockTokens": 200000,
  "idleResumeMinutes": 60,
  "transcriptTailBytes": 600000,
  "maxFileBytesForLineCount": 4000000,
  "handoffMaxWords": 400,
  "taskPromptMaxWords": 160,
  "handoffExemptPromptPrefixes": ["/handoff", "/compact", "/clear"],
  "resumePromptPattern": "^\\s*(continue|resume|keep going|go on)\\b",
  "guardAuditLogEnv": "AGENT_GUARD_AUDIT_LOG",
  "telemetryDirEnv": "CLAUDE_TELEMETRY_DIR",
  "hookStderrMaxChars": 600,
  "quietFailTailLines": 40,
  "quietLogDir": "node_modules/.cache/bluewave-quiet"
}
